# Required secrets (generate random 64-char hex strings, e.g. `openssl rand -hex 32`)
APP_KEYS=replace-with-key-1,replace-with-key-2
ADMIN_JWT_SECRET=replace-with-secret
API_TOKEN_SALT=replace-with-salt
TRANSFER_TOKEN_SALT=replace-with-transfer-salt
ENCRYPTION_KEY=replace-with-encryption-key
STUDIO_TOKEN=replace-with-studio-token

# Optional runtime settings (defaults shown)
OLLAMA_MODEL=qwen2.5:3b
DATA_DIR=/data
YTDLP_COOKIES_FILE=/data/cookies.txt
SUPADATA_API_KEY=replace-with-optional-supadata-key
GEMINI_API_KEY=replace-with-optional-gemini-key
